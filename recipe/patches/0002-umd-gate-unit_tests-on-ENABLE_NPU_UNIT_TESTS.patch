From: Mark Harfouche <mark.harfouche@conda-forge.org>
Date: Sun, 10 May 2026 00:00:00 +0000
Subject: umd: add ENABLE_NPU_UNIT_TESTS to gate the unit test subdirectories

umd/CMakeLists.txt adds vpu_driver/unit_tests and
level_zero_driver/unit_tests unconditionally. Both link against GoogleTest
and GoogleMock and exist for developing the driver itself, but there is no
way to switch them off: ENABLE_VALIDATION_BUILD covers only the
validation/ tree.

A build that wants just the runtime driver therefore has to make
GoogleTest available even though nothing it installs depends on it.

Add an ENABLE_NPU_UNIT_TESTS option gating both subdirectory adds. It
defaults to ON, matching ENABLE_VALIDATION_BUILD and leaving the existing
behaviour of a default build unchanged; packagers that ship only the
driver can now pass -DENABLE_NPU_UNIT_TESTS=OFF.

Signed-off-by: Mark Harfouche <mark.harfouche@conda-forge.org>

---
 CMakeLists.txt     | 1 +
 umd/CMakeLists.txt | 8 ++++++--
 2 files changed, 7 insertions(+), 2 deletions(-)
diff --git a/CMakeLists.txt b/CMakeLists.txt
index ceb1b87..640acd7 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -43,6 +43,7 @@ option(ENABLE_COMPILATION_FLAGS_OVERRIDE "Allow to override flags passed to comp
 # The npu_elf target is picked up from the compiler package
 option(ENABLE_NPU_ELF_BUILD "Enable building NPU Elf library in driver" OFF)
 option(ENABLE_TOOLS_BUILD "Enable building tools" OFF)
+option(ENABLE_NPU_UNIT_TESTS "Enable building umd unit tests" ON)
 option(ENABLE_NPU_ALT_DEPENDENCY_PATH_OVERRIDE "Allow to override path for dependencies in driver" OFF)

 message(STATUS "option ENABLE_OPENVINO_PACKAGE: ${ENABLE_OPENVINO_PACKAGE}")
diff --git a/umd/CMakeLists.txt b/umd/CMakeLists.txt
index 1e0de53..6cc5a1d 100644
--- a/umd/CMakeLists.txt
+++ b/umd/CMakeLists.txt
@@ -61,8 +61,12 @@ include_directories(${VPU_SOURCE_DIR})
 include_directories(SYSTEM ${VPU_KMD_INCLUDE_DIR})

 add_subdirectory_unique(vpu_driver/source)
-add_subdirectory_unique(vpu_driver/unit_tests)
+if (ENABLE_NPU_UNIT_TESTS)
+    add_subdirectory_unique(vpu_driver/unit_tests)
+endif()

 add_subdirectory_unique(level_zero_driver/source)
-add_subdirectory_unique(level_zero_driver/unit_tests)
+if (ENABLE_NPU_UNIT_TESTS)
+    add_subdirectory_unique(level_zero_driver/unit_tests)
+endif()
 add_subdirectory_unique(level_zero_driver/api)
